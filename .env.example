# iKoPilot.com Environment Configuration
# Copy to .env and fill in values

# Database
POSTGRES_USER=ikopilot
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=ikopilot
DATABASE_URL=postgresql+asyncpg://ikopilot:change_me_to_a_strong_password@postgres:5432/ikopilot

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change_me_to_a_random_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM API Keys (Admin managed — never exposed to users)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
DEEPSEEK_API_KEY=dsk-...

# Admin
ADMIN_EMAIL=admin@ikopilot.com
ADMIN_PASSWORD=change_me

# Stripe (Phase 4)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Paystack (Phase 4)
PAYSTACK_SECRET_KEY=sk_test_...

# App
APP_NAME=iKoPilot.com
APP_URL=https://ikopilot.com
ENVIRONMENT=production
DEBUG=false

# CORS
CORS_ORIGINS=["https://ikopilot.com"]

# SMTP (for password reset emails)
# Leave SMTP_HOST empty to disable email — reset links will be returned in API response instead
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=noreply@ikopilot.com
SMTP_FROM_NAME=iKoPilot.com
